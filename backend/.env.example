# ------------------------------------------------------------------
# DHARA backend configuration
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real .env file (it is listed in .gitignore).
# ------------------------------------------------------------------

# Port the API server listens on
PORT=4000

# Allowed frontend origin(s) for CORS, comma-separated. Use * during development.
CORS_ORIGIN=*

# Serve the /frontend folder from this server (true/false)
SERVE_FRONTEND=true

# --- Air quality ---------------------------------------------------
# Primary source: Open-Meteo (no key needed)
# Fallback source: OpenWeatherMap Air Pollution API – https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# Timeout for each external API call (ms)
API_TIMEOUT_MS=8000

# How long a location's air-quality reading is cached (ms)
AQ_CACHE_TTL_MS=300000

# --- AI report (Google Gemini) -------------------------------------
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Max AI report requests per client IP per minute
REPORT_RATE_LIMIT_PER_MIN=10

# --- Geocoding (OpenStreetMap Nominatim) ----------------------------
# Nominatim's usage policy requires an identifying User-Agent
NOMINATIM_USER_AGENT=DHARA-DigitalTwin/1.0 (student project)
